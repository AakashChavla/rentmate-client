name: CI

on:
  push:
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest
    env:
      NEXT_PUBLIC_API_URL: http://localhost:3000/api/v1
      NEXT_PUBLIC_API_ORIGIN: http://localhost:3000
      NEXT_PUBLIC_APP_NAME: RentMate
      API_OPENAPI_URL: http://localhost:3000/api/docs-json
