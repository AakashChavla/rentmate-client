{
  "name": "rentmate-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\" --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "rules:check": "tsx tools/check-rules.ts",
    "i18n:check": "tsx tools/check-i18n.ts",
    "i18n:types": "tsx tools/generate-i18n.ts",
    "rules:proof": "tsx tools/prove-rules.ts",
    "gen": "plop --plopfile tools/codegen/plopfile.cjs",
    "prepare": "husky",
    "verify:quick": "yarn lint && yarn typecheck && yarn arch:check && yarn rules:check && yarn i18n:check && yarn test && yarn build",
    "dev": "next dev -p 3001 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3001 -H 127.0.0.1",
    "test": "vitest run",
    "verify": "yarn verify:quick",
    "api:types": "openapi-typescript ../rentmate-server/docs/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "1",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^14.2.0",
    "next-intl": "^4.0.0",
    "next-themes": "0.4",
    "radix-ui": "1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7",
    "sonner": "2",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest-axe": "3",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-i18next": "^6.1.0",
    "husky": "^9.1.7",
    "jest-axe": "10",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.0",
    "msw": "2",
    "openapi-typescript": "^7.10.0",
    "plop": "^4.0.0",
    "postcss": "8.5.28",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,cjs,mjs,yml,css}": "prettier --write"
  },
  "resolutions": {
    "postcss": "8.5.28"
  }
}
