{
  "name": "rentmate-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\" --fix",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "rules:check": "tsx tools/check-rules.ts",
    "i18n:check": "tsx tools/check-i18n.ts",
    "i18n:types": "tsx tools/generate-i18n.ts",
    "rules:proof": "tsx tools/prove-rules.ts",
    "gen": "plop --plopfile tools/codegen/plopfile.cjs",
    "prepare": "husky",
    "verify:quick": "yarn lint && yarn typecheck && yarn arch:check && yarn rules:check && yarn i18n:check && yarn test && yarn build",
    "dev": "next dev -p 3001 -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start -p 3001 -H 127.0.0.1",
    "test": "vitest run",
    "verify": "yarn verify:quick",
    "api:types": "openapi-typescript ../rentmate-server/docs/openapi.json -o src/lib/api/schema.d.ts",
    "audit": "yarn npm audit --all --recursive"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.5.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-i18next": "6.1.5",
    "husky": "9.1.7",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "msw": "3.0.2",
    "openapi-typescript": "7.13.0",
    "plop": "4.0.5",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,cjs,mjs,yml,css}": "prettier --write"
  }
}
