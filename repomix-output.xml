<file path="src/lib/api/client.test.ts">
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import {
  ApiError,
  apiClient,
  resetApiClientForTests,
  setUnauthorizedHandlerForTests,
} from "@/lib/api/client";

function jsonResponse(body: unknown, status = 200, requestId?: string): Response {
  const headers = new Headers({ "Content-Type": "application/json" });
  if (requestId) headers.set("X-Request-ID", requestId);
  return new Response(JSON.stringify(body), { status, headers });
}

describe("apiClient", () => {
  const fetchMock = vi.fn<typeof fetch>();

  beforeEach(() => {
    resetApiClientForTests();
    fetchMock.mockReset();
    vi.stubGlobal("fetch", fetchMock);
  });

  afterEach(() => {
    resetApiClientForTests();
    vi.unstubAllGlobals();
  });

  it("unwraps the success envelope and ignores meta", async () => {
    fetchMock.mockResolvedValueOnce(
      jsonResponse({ success: true, data: { status: "ok" }, meta: { page: 1 } }),
    );

    const result = await apiClient<{ status: string }>("/health");

    expect(result).toEqual({ status: "ok" });
    const [url, init] = fetchMock.mock.calls[0] ?? [];
    expect(url).toBe("http://localhost:3000/api/v1/health");
    expect(init?.credentials).toBe("include");
    const headers = new Headers(init?.headers);
    expect(headers.get("X-Request-ID")).toBeTruthy();
  });

  it("returns a non-envelope JSON body when the call succeeds", async () => {
    fetchMock.mockResolvedValueOnce(jsonResponse({ status: "ready" }));

    await expect(
      apiClient<{ status: string }>("http://localhost:3000/health/ready"),
    ).resolves.toEqual({ status: "ready" });
    expect(fetchMock.mock.calls[0]?.[0]).toBe("http://localhost:3000/health/ready");
  });

  it("throws ApiError from the error envelope and keeps the response request id", async () => {
    fetchMock.mockResolvedValueOnce(
      jsonResponse(
        {
          success: false,
          error: {
            code: "VALIDATION_ERROR",
            message: "Invalid email",
            details: { field: "email" },
          },
        },
        422,
        "srv-req-1",
      ),
    );

    const error = await apiClient("/tenants").catch((caught: unknown) => caught);

    expect(error).toBeInstanceOf(ApiError);
    expect(error).toMatchObject({
      code: "VALIDATION_ERROR",
      message: "Invalid email",
      status: 422,
      details: { field: "email" },
      requestId: "srv-req-1",
    });
  });

  it("refreshes once after a 401 and retries the original request", async () => {
    fetchMock
      .mockResolvedValueOnce(
        jsonResponse(
          { success: false, error: { code: "UNAUTHORIZED", message: "Expired" } },
          401,
        ),
      )
      .mockResolvedValueOnce(jsonResponse({ success: true, data: null }))
      .mockResolvedValueOnce(
        jsonResponse({ success: true, data: { id: "user_1" }, meta: {} }),
      );

    const result = await apiClient<{ id: string }>("/auth/me");

    expect(result).toEqual({ id: "user_1" });
    expect(fetchMock).toHaveBeenCalledTimes(3);
    expect(fetchMock.mock.calls[1]?.[0]).toBe(
      "http://localhost:3000/api/v1/auth/refresh",
    );
    expect(fetchMock.mock.calls[1]?.[1]).toMatchObject({
      method: "POST",
      credentials: "include",
    });
    expect(fetchMock.mock.calls[2]?.[0]).toBe("http://localhost:3000/api/v1/auth/me");
  });

  it("redirects to login when refresh fails and does not retry again", async () => {
    const onUnauthorized = vi.fn();
    setUnauthorizedHandlerForTests(onUnauthorized);
    fetchMock
      .mockResolvedValueOnce(
        jsonResponse(
          { success: false, error: { code: "UNAUTHORIZED", message: "Expired" } },
          401,
          "expired-1",
        ),
      )
      .mockResolvedValueOnce(jsonResponse({ success: false }, 401));

    await expect(apiClient("/auth/me")).rejects.toMatchObject({
      status: 401,
      requestId: "expired-1",
    });
    expect(onUnauthorized).toHaveBeenCalledTimes(1);
    expect(fetchMock).toHaveBeenCalledTimes(2);
  });
});
</file>

<file path="src/lib/api/client.ts">
import { env } from "@/env";
import { LOGIN_PATH } from "@/lib/auth/constants";

type ErrorBody = {
  code?: string;
  message?: string;
  details?: unknown;
};

type SuccessEnvelope<T> = {
  success: true;
  data: T;
  meta?: unknown;
};

type ErrorEnvelope = {
  success: false;
  error?: ErrorBody;
};

export type ApiRequestOptions = RequestInit & {
  /** When true, a 401 does not trigger refresh-and-retry. */
  skipAuthRefresh?: boolean;
};

export class ApiError extends Error {
  readonly code: string;
  readonly status: number;
  readonly details?: unknown;
  readonly requestId?: string;

  constructor(params: {
    code: string;
    message: string;
    status: number;
    details?: unknown;
    requestId?: string;
  }) {
    super(params.message);
    this.name = "ApiError";
    this.code = params.code;
    this.status = params.status;
    this.details = params.details;
    this.requestId = params.requestId;
  }
}

let refreshPromise: Promise<boolean> | null = null;

function redirectToLogin(): void {
  if (typeof window === "undefined") return;
  if (window.location.pathname === LOGIN_PATH) return;
  window.location.assign(LOGIN_PATH);
}

let onUnauthorized: () => void = redirectToLogin;

/** @internal Resets module state between tests. */
export function resetApiClientForTests(): void {
  refreshPromise = null;
  onUnauthorized = redirectToLogin;
}

/** @internal Replaces the 401 redirect so tests can observe it. */
export function setUnauthorizedHandlerForTests(handler: () => void): void {
  onUnauthorized = handler;
}

function createRequestId(): string {
  if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
    return crypto.randomUUID();
  }
  return `req_${Date.now()}`;
}

function resolveUrl(path: string): string {
  if (path.startsWith("http://") || path.startsWith("https://")) {
    return path;
  }
  const base = env.NEXT_PUBLIC_API_URL.replace(/\/$/, "");
  const suffix = path.startsWith("/") ? path : `/${path}`;
  return `${base}${suffix}`;
}

function readRequestId(response: Response, fallback: string): string {
  return response.headers.get("X-Request-ID") ?? fallback;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null;
}

function isSuccessEnvelope(value: unknown): value is SuccessEnvelope<unknown> {
  return isRecord(value) && value.success === true && "data" in value;
}

function isErrorEnvelope(value: unknown): value is ErrorEnvelope {
  return isRecord(value) && value.success === false;
}

async function parseBody(response: Response): Promise<unknown> {
  const text = await response.text();
  if (!text) return null;
  try {
    return JSON.parse(text) as unknown;
  } catch {
    return text;
  }
}

function errorFromBody(
  body: unknown,
  status: number,
  requestId: string,
  fallbackMessage: string,
): ApiError {
  if (isErrorEnvelope(body)) {
    return new ApiError({
      code: body.error?.code ?? "REQUEST_FAILED",
      message: body.error?.message ?? fallbackMessage,
      status,
      details: body.error?.details,
      requestId,
    });
  }

  return new ApiError({
    code: "REQUEST_FAILED",
    message: fallbackMessage,
    status,
    requestId,
  });
}

function unwrap<T>(body: unknown, response: Response, requestId: string): T {
  if (isErrorEnvelope(body)) {
    throw errorFromBody(
      body,
      response.status,
      requestId,
      response.statusText || "Request failed",
    );
  }

  if (!response.ok) {
    throw errorFromBody(
      body,
      response.status,
      requestId,
      response.statusText || "Request failed",
    );
  }

  if (isSuccessEnvelope(body)) {
    return body.data as T;
  }

  return body as T;
}

async function refreshSession(): Promise<boolean> {
  const requestId = createRequestId();
  try {
    const response = await fetch(resolveUrl("/auth/refresh"), {
      method: "POST",
      credentials: "include",
      headers: {
        Accept: "application/json",
        "X-Request-ID": requestId,
      },
    });
    return response.ok;
  } catch {
    return false;
  }
}

function refreshOnce(): Promise<boolean> {
  if (!refreshPromise) {
    refreshPromise = refreshSession().finally(() => {
      refreshPromise = null;
    });
  }
  return refreshPromise;
}

export async function apiClient<T>(
  path: string,
  options: ApiRequestOptions = {},
): Promise<T> {
  const { skipAuthRefresh = false, headers: initHeaders, ...init } = options;
  const requestId = createRequestId();
  const headers = new Headers(initHeaders);

  if (!headers.has("Accept")) {
    headers.set("Accept", "application/json");
  }
  if (
    init.body !== undefined &&
    !(init.body instanceof FormData) &&
    !headers.has("Content-Type")
  ) {
    headers.set("Content-Type", "application/json");
  }
  headers.set("X-Request-ID", requestId);

  let response: Response;
  try {
    response = await fetch(resolveUrl(path), {
      ...init,
      headers,
      credentials: "include",
    });
  } catch (error) {
    throw new ApiError({
      code: "NETWORK_ERROR",
      message: error instanceof Error ? error.message : "Network request failed",
      status: 0,
      requestId,
    });
  }

  if (response.status === 401 && !skipAuthRefresh) {
    const refreshed = await refreshOnce();
    if (refreshed) {
      return apiClient<T>(path, { ...options, skipAuthRefresh: true });
    }
    onUnauthorized();
    const body = await parseBody(response);
    throw errorFromBody(
      body,
      401,
      readRequestId(response, requestId),
      "Your session has expired",
    );
  }

  const body = await parseBody(response);
  return unwrap<T>(body, response, readRequestId(response, requestId));
}
</file>

<file path="src/lib/api/query-client.ts">
import { QueryClient } from "@tanstack/react-query";
import { ApiError } from "@/lib/api/client";

function shouldRetry(failureCount: number, error: unknown): boolean {
  if (error instanceof ApiError && error.status >= 400 && error.status < 500) {
    return false;
  }
  return failureCount < 2;
}

export function createQueryClient(): QueryClient {
  return new QueryClient({
    defaultOptions: {
      queries: {
        staleTime: 30_000,
        refetchOnWindowFocus: false,
        retry: shouldRetry,
      },
      mutations: {
        retry: false,
      },
    },
  });
}
</file>

